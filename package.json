{
  "name": "ms_store",
  "version": "1.0.0",
  "description": "Full-Stack Shop Billing, Stock Inventory & Profit/Loss App with 3D Effects",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.1.2"
  }
}
